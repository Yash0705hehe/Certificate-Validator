# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
#
# Project: aa-impact-cert-registry-test
SUPABASE_URL=https://ukhzxqxugzqcfqcwnmvu.supabase.co

# Service-role key — required to write to the certificates table and the
# private certificates storage bucket. Find it in:
#   Supabase Dashboard > Project Settings > API > service_role (secret).
# Keep it secret. In CI, store it as the SUPABASE_SERVICE_ROLE_KEY GitHub Secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) — only needed for emailing certificates ---
# Create an API key at https://resend.com and verify your sending domain.
# In CI, store these as the RESEND_API_KEY / RESEND_FROM GitHub Secrets.
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend.
RESEND_FROM=AA Impact Academy <certificates@aaimpactinc.com>
