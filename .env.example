# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
#
# Project: aa-impact-cert-registry-test
SUPABASE_URL=https://ukhzxqxugzqcfqcwnmvu.supabase.co

# Service-role key — required to write to the certificates table and the
# private certificates storage bucket. Find it in:
#   Supabase Dashboard > Project Settings > API > service_role (secret).
# Keep it secret. In CI, store it as the SUPABASE_SERVICE_ROLE_KEY GitHub Secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Brevo) — only needed for emailing certificates ---
# Create an API key at https://brevo.com. Verify the sender address (a link is
# emailed to it) — no DNS needed to start. In CI, store as GitHub Secrets.
BREVO_API_KEY=
# Sender, "Name <email>" — a verified sender (or on a verified domain) in Brevo.
BREVO_FROM=AA Impact Academy <certificate@aaimpactinc.com>

# --- Paid enrolment (Wix checkout on aaimpactinc.com) — see docs/WIX_ENROLMENT_SETUP.md ---
# JSON map of our course key -> the Zoho Learn course-access link emailed to a
# buyer after they pay, so they can sign up and start the course.
COURSE_ACCESS_URLS={"GHG": "https://learn.zoho.in/portal/aa-impact/course/scope-3-quiz"}

# --- Wix Forms email capture (poll_wix_submissions.py) ---
# The site charges via a Wix "Forms & Payments" form, so buyers are read from
# CONFIRMED (paid) form submissions. Create an account API key with the Wix
# Forms "Read Submissions" permission at https://manage.wix.com/account/api-keys.
WIX_API_KEY=
# Site id (API keys are account-level, so the request needs it). AA Impact site:
WIX_SITE_ID=bc6a0452-5643-4224-a190-e0c157754f82
# JSON map of each PAID form id -> our course key. The "Payment" form sells GHG:
WIX_FORM_COURSE_MAP={"a2b557bc-9d1e-4125-bf90-9224c5c07978": "GHG"}
# Optional volume guard: only look at submissions this many days back (0 = all).
WIX_POLL_LOOKBACK_DAYS=0

# --- Zoho Learn (for auto-issue on course completion) ---
# See docs/ZOHO_SETUP.md. Store as GitHub Secrets in CI. India DC shown (.in).
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in
ZOHO_API_DOMAIN=learn.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Portal slug from your Zoho Learn URL (learn.zoho.in/portal/<slug>/...):
ZOHO_PORTAL=aa-impact
# Map each Zoho course NAME (as it appears in the completion email) to its Zoho
# course id + our course key (GHG / Nature / GHG_Nature_Bundle):
ZOHO_COURSE_MAP={"GHG Accounting Course": {"id": "58084000000002174", "course": "GHG"}}

# --- Fully-automatic enrolment of new (non-Zoho) buyers (optional) ---
# A brand-new buyer isn't a Zoho user yet, so they can't be silently enrolled.
# Set ZOHO_AUTO_ENROLL=true to have the purchase hook INVITE them to the hub by
# email, then auto-enrol them into the course (as a MEMBER/learner — they still
# can't share it) on a later poll once they've accepted the invite. See
# docs/ZOHO_SETUP.md → Part C. The refresh token must ALSO carry the
# ZohoLearn.hubMember.CREATE + ZohoLearn.hubMember.READ scopes.
# Leave blank/false to keep the current behaviour (email the buyer a link).
ZOHO_AUTO_ENROLL=
# Optional: override the hub endpoints if your DC / hub path differs.
# ZOHO_HUB_INVITE_URL=
# ZOHO_HUB_MEMBERS_URL=

# --- Microsoft Graph (read certificate@ mailbox for completion emails) ---
# See docs/MS_GRAPH_SETUP.md. Mint MS_REFRESH_TOKEN via scripts/ms_device_login.py.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_REFRESH_TOKEN=
# Only if you registered a confidential (secret) client; leave blank for public.
MS_CLIENT_SECRET=
